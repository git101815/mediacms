FROM python:3.13.5-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG BENTO4_VERSION=1-6-0-641
ARG BENTO4_ZIP=Bento4-SDK-${BENTO4_VERSION}.x86_64-unknown-linux.zip
ARG BENTO4_URL=https://www.bok.net/Bento4/binaries/${BENTO4_ZIP}

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        imagemagick \
        libxml2-dev \
        libxmlsec1-dev \
        libxmlsec1-openssl \
        pkg-config \
        postgresql-client \
        unzip && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /home/mediacms.io/bento4 && \
    curl -fsSL --retry 5 --retry-delay 3 "${BENTO4_URL}" -o "/tmp/${BENTO4_ZIP}" && \
    unzip -q "/tmp/${BENTO4_ZIP}" -d /home/mediacms.io/bento4 && \
    mv "/home/mediacms.io/bento4/Bento4-SDK-${BENTO4_VERSION}.x86_64-unknown-linux/"* /home/mediacms.io/bento4/ && \
    rm -rf "/home/mediacms.io/bento4/Bento4-SDK-${BENTO4_VERSION}.x86_64-unknown-linux" "/tmp/${BENTO4_ZIP}" /home/mediacms.io/bento4/docs

RUN ffmpeg -hide_banner -encoders 2>&1 | grep -q libx264 && \
    ffmpeg -hide_banner -encoders 2>&1 | grep -q libx265 && \
    ffmpeg -hide_banner -encoders 2>&1 | grep -q libsvtav1

COPY requirements.txt requirements-dev.txt /tmp/mediacms-requirements/
RUN pip install --no-cache-dir --no-binary lxml,xmlsec -r /tmp/mediacms-requirements/requirements-dev.txt

COPY deploy/docker/policy.xml /etc/ImageMagick-6/policy.xml

WORKDIR /workspace
CMD ["pytest", "-ra"]
